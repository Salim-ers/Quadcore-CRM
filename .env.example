# Pour `npm run dev` branché sur Neon, à copier dans .env.local (déjà rempli en partie par `npx neon env pull`).
# La version en ligne lit .env.production ; sans ces deux variables, `npm run dev` démarre en mode démonstration.
VITE_NEON_DATA_API_URL=https://ep-xxx.apirest.c-8.eu-central-1.aws.neon.tech/neondb/rest/v1
VITE_NEON_FILES_URL=https://br-xxx-fichiers.compute.c-8.eu-central-1.aws.neon.tech

# Écrite par `npx neon env pull`. Sert au relais d'authentification en local.
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.c-8.eu-central-1.aws.neon.tech/neondb/auth

# Pour `npm run neon:installer` : adresse publique de l'application
APP_URL=https://quadcore-crm.vercel.app

# Forcer le mode démonstration même avec Neon configuré (1 = oui)
VITE_DEMO=0
