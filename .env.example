# Supabase › Project Settings › API Keys
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé publique : « publishable » (sb_publishable_...) ou ancienne clé « anon » (eyJ...). Jamais la clé secrète.
VITE_SUPABASE_ANON_KEY=sb_publishable_...
# Forcer le mode démonstration même avec Supabase configuré (1 = oui)
VITE_DEMO=0
