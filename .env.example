# Pour l'application (à définir aussi dans Cloudflare Pages)
# Neon › Postgres database › Data API, ou `npx neon data-api get`
VITE_NEON_DATA_API_URL=https://ep-xxx.apirest.c-2.eu-central-1.aws.neon.tech/neondb/rest/v1
# Adresse de la fonction : `npx neon functions get fichiers`
VITE_NEON_FILES_URL=https://xxx-fichiers.compute.c-2.eu-central-1.aws.neon.tech

# Pour `npm run dev` branché sur Neon, et à définir dans Cloudflare Pages comme variable de la fonction
NEON_AUTH_URL=https://ep-xxx.neonauth.c-2.eu-central-1.aws.neon.tech/neondb/auth

# Pour `npm run neon:installer` : adresse publique de l'application
APP_URL=https://app.quad-core.fr

# Forcer le mode démonstration même avec Neon configuré (1 = oui)
VITE_DEMO=0
